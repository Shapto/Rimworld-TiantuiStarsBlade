<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<HediffDef>
		<defName>Tiantui_Overheated</defName>
		<label>Overheat</label>
		<description>The Tiantui Star's Blade has overheated. Its rounds can't be fired until it cools, its strikes land weaker, and the scorching steel leaves its wielder exposed.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.95, 0.4, 0.2)</defaultLabelColor>
		<isBad>true</isBad>
		<stages>
			<li>
				<statFactors>
					<MeleeDamageFactor>0.75</MeleeDamageFactor>
					<IncomingDamageFactor>1.3</IncomingDamageFactor>
				</statFactors>
				<statOffsets>
					<MeleeHitChance>-10</MeleeHitChance>
				</statOffsets>
			</li>
		</stages>
		<comps>
			<li Class="Tiantui_Stars_Blade.HediffCompProperties_TiantuiBladeLink">
				<onlyWhileOverheated>true</onlyWhileOverheated>
			</li>
		</comps>
	</HediffDef>

