					</li>
				</tigerslayerOnHitEffects>
				<savageTigerslayerOnHitEffects>
					<li Class="SingularityFramework.Strikes.OnHitEffect_ExtraDamage">
						<damageDefinition>Blunt</damageDefinition>
						<damageAmount>12</damageAmount>
						<armorPenetration>0.9</armorPenetration>
					</li>
					<li Class="SingularityFramework.Strikes.OnHitEffect_ExtraDamage">
						<damageDefinition>Burn</damageDefinition>
						<damageAmount>10</damageAmount>
					</li>
				</savageTigerslayerOnHitEffects>
				<finisherOnHitEffects>
					<li Class="SingularityFramework.Strikes.OnHitEffect_Stun">
						<stunTicks>90</stunTicks>
					</li>
				</finisherOnHitEffects>
