					<li>Tiantui_Tigerslayer</li>
					<li>Tiantui_PerfectedFlurry</li>
				</abilities>
			</li>
			<li Class="CompProperties_Styleable"/>
			<li Class="SingularityFramework.Relics.CompProperties_RelicAptitude">
				<fullAptitudeRequirements>
					<li Class="SingularityFramework.Relics.AptitudeRequirement_Skill">
						<skill>Melee</skill>
						<minimum>16</minimum>
					</li>
					<li Class="SingularityFramework.Relics.AptitudeRequirement_Capacity">
						<capacity>Consciousness</capacity>
						<minimum>1</minimum>
					</li>
					<li Class="SingularityFramework.Relics.AptitudeRequirement_Passion">
						<skill>Melee</skill>
						<minimum>1</minimum>
					</li>
					<li Class="SingularityFramework.Relics.AptitudeRequirement_AnyOf">
						<labelKey>Tiantui_AptitudeBattleFreak</labelKey>
						<options>
							<li Class="SingularityFramework.Relics.AptitudeRequirement_Trait">
								<trait>Bloodlust</trait>
							</li>
							<li Class="SingularityFramework.Relics.AptitudeRequirement_Trait">
								<trait>Brawler</trait>
							</li>
							<li Class="SingularityFramework.Relics.AptitudeRequirement_Passion">
								<skill>Melee</skill>
								<minimum>2</minimum>
							</li>
						</options>
					</li>
				</fullAptitudeRequirements>
				<partialAptitudeRequirements>
					<li Class="SingularityFramework.Relics.AptitudeRequirement_Skill">
						<skill>Melee</skill>
						<minimum>10</minimum>
					</li>
					<li Class="SingularityFramework.Relics.AptitudeRequirement_Capacity">
						<capacity>Consciousness</capacity>
