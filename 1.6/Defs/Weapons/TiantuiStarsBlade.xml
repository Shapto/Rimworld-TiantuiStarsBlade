					</li>
				</partialAptitudeRequirements>
				<rejectsUnworthy>false</rejectsUnworthy>
				<partialStatFactors>
					<Tiantui_HeatBuildup>2</Tiantui_HeatBuildup>
					<MeleeWeapon_DamageMultiplier>0.85</MeleeWeapon_DamageMultiplier>
				</partialStatFactors>
				<unworthyStatFactors>
