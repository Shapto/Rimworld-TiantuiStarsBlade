<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BaseMeleeWeapon_Sharp">
		<defName>TiantuiStarsBlade</defName>
		<label>Tiantui Star's Blade</label>
		<description>A hefty, heavily customized broadsword forged from a relic blade. It is fitted with a cylinder firing specialized ammunition to boost it forward through exhausts lining the blade's spine, allowing for immense burst mobility and devastating jet-propelled slashes. It's obvious wielding such a thing requires exceptional skill and strength, but above all, it demands heart! The spirit to fight and kill! The balls to see shit through for the thrill of it all! If you're not in it for the love of the game, it'll knock you flat on your ass in no time.</description>
		<graphicData>
			<texPath>Weapons/TiantuiStarsBlade</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.6, 1.6)</drawSize>
		</graphicData>
		<equippedAngleOffset>-45</equippedAngleOffset>
		<techLevel>Ultra</techLevel>
		<useHitPoints>false</useHitPoints>
		<smeltable>false</smeltable>
		<burnableByRecipe>false</burnableByRecipe>
		<recipeMaker IsNull="True"/>
		<tradeability>Sellable</tradeability>
		<relicChance>1</relicChance>
		<thingSetMakerTags>
			<li>RewardStandardLowFreq</li>
		</thingSetMakerTags>
		<meleeHitSound>Tiantui_Swing</meleeHitSound>
		<statBases>
			<Mass>3.5</Mass>
			<Beauty>5</Beauty>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
			<MarketValue>3000</MarketValue>
			<Tiantui_HeatBuildup>1</Tiantui_HeatBuildup>
		</statBases>
		<weaponClasses Inherit="False">
			<li>Melee</li>
			<li>Ultratech</li>
		</weaponClasses>
		<tools>
			<li>
				<label>edge</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>27</power>
				<cooldownTime>2</cooldownTime>
				<armorPenetration>0.9</armorPenetration>
				<soundMeleeHit>Tiantui_Swing</soundMeleeHit>
			</li>
		</tools>
		<comps Inherit="False">
			<li Class="CompProperties_Forbiddable"/>
			<li>
				<compClass>CompEquippable</compClass>
			</li>
			<li Class="SingularityFramework.Equipment.CompProperties_GrantAbilities">
